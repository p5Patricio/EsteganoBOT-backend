# Esteganobot Backend - Entorno de Producción (Render)

PORT=3000
NODE_ENV=production

# Lista de orígenes permitidos separados por coma (ej: tu-app.vercel.app,localhost:8080)
CORS_ORIGIN=https://tu-app-frontend.vercel.app

# Límites de seguridad
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50
MAX_FILE_SIZE_MB=5
